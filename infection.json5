{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": ["Commands", "Support"]
    },
    "logs": {
        "text": "infection.log",
        "html": "infection.html",
    },
    "mutators": {
        "@default": true,
        "MBString": false,
        "MethodCallRemoval": {
            "ignore": [
                "Xammie\\Mailbook\\Data\\MailableItem::send::213",
                "Xammie\\Mailbook\\Data\\MailableItem::send::224",
                "Xammie\\Mailbook\\Data\\MailableItem::send::232",
            ],
        },
        "UnwrapArrayUnique": {
            "ignore": [
                "Xammie\\Mailbook\\Data\\ResolvedMail::replaceEmbeddedAttachments::120",
            ],
        },
        "ReturnRemoval": {
            "ignore": [
                "Xammie\\Mailbook\\Data\\ResolvedMail::attachments::144",
                "Xammie\\Mailbook\\Data\\MailableItem::currentVariant::162"
            ],
        },
        "IfNegation": {
            "ignore": [
                "Xammie\\Mailbook\\Data\\MailableItem::send::212",
                "Xammie\\Mailbook\\Data\\ResolvedMail::attachments::143"
            ],
        },
        "Break_": {
            "ignore": [
                "Xammie\\Mailbook\\Data\\ResolvedMail::replaceEmbeddedAttachments::129"
            ],
        }
    }
}
